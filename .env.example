# Local public URL used by browser-side integrations and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string. Locally: `docker compose up -d` then use the
# credentials from docker-compose.yml.
DATABASE_URL="postgresql://alusan:alusan@localhost:5434/alusan"

# Random secret used to sign admin session tokens (JWT). Generate your own,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Changing it instantly invalidates all existing admin sessions.
AUTH_SECRET="replace-with-a-random-secret"

# Credentials used by `pnpm db:seed` to create the first AdminUser row (role
# "owner") if one doesn't exist yet. Only used once (create, not overwrite) —
# change the password afterwards from /admin → "Профиль", not by re-seeding.
ADMIN_EMAIL="admin@alusan.ru"
ADMIN_PASSWORD="admin12345"

# Idle window, in hours: how long an admin can go without visiting /admin
# before needing to log in again. Each visit slides the window forward (see
# proxy.ts), so an active session never expires mid-work — this only matters
# for abandoned/stolen sessions. Optional, defaults to 5 if unset or invalid.
ADMIN_SESSION_IDLE_HOURS="5"