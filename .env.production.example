# Переменные для прод-деплоя (docker-compose.prod.yml). Скопировать в
# .env.production на сервере и заполнить реальными значениями — этот файл
# в .gitignore, на сервер попадает не через git.

# Пароль Postgres — придумай свой, используется и здесь, и внутри DATABASE_URL ниже.
DB_PASSWORD="замени-на-длинный-случайный-пароль"

# host "db" — это имя сервиса Postgres внутри docker-compose, не localhost.
# Порт 5432 — обычный порт Postgres внутри докер-сети (не 5434, это было
# только для локальной разработки, где он мог конфликтовать с другим Postgres).
DATABASE_URL="postgresql://alusan:замени-на-длинный-случайный-пароль@db:5432/alusan"

# Секрет для подписи сессий админки. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="замени-на-случайный-секрет"

# Первый аккаунт владельца — создаётся один раз при первом db:seed.
# Пароль смени потом через /admin → "Профиль", это только бутстрап.
ADMIN_EMAIL="admin@alusan.pro"
ADMIN_PASSWORD="замени-на-нормальный-пароль"

ADMIN_SESSION_IDLE_HOURS="5"

NEXT_PUBLIC_SITE_URL="https://alusan.pro"
NODE_ENV="production"
