generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  order       Int       @default(0)
  products    Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  code        String
  name        String
  description String
  spec        String
  material    String
  tone        String
  images      String[] @default([])
  featured    Boolean  @default(false)
  order       Int      @default(0)
  publishedAt DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@map("products")
}

enum ArticleStatus {
  draft
  published
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  body        String        @db.Text
  status      ArticleStatus @default(draft)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("articles")
}

enum LeadStatus {
  new
  contacted
  closed
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  phone     String
  email     String?
  comment   String?
  source    String
  status    LeadStatus @default(new)
  createdAt DateTime   @default(now())

  @@map("leads")
}

enum AdminRole {
  owner
  manager
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  firstName    String?
  lastName     String?
  passwordHash String
  role         AdminRole @default(manager)
  createdAt    DateTime  @default(now())

  @@map("admin_users")
}

// Единственная строка с контактами сайта (телефон/почта/адрес) — редактируется
// из админки позже, фронт уже читает отсюда вместо хардкода.
model SiteSettings {
  id        String @id @default("singleton")
  phone     String
  email     String
  city      String
  address   String
  legalName String @default("")
  inn       String @default("")

  @@map("site_settings")
}

// Карточки на /documents (сертификаты/паспорта/протоколы). category — просто
// строка-ярлык вкладки ("Сертификаты"/"Паспорта"/"Документация"), не отдельная
// таблица — вкладок всегда немного и они не самостоятельная сущность с URL,
// как категории каталога.
model Document {
  id       String  @id @default(cuid())
  title    String
  subtitle String
  category String
  code     String
  color    String
  fileUrl  String?
  order    Int     @default(0)

  @@map("documents")
}

// Файлы (фото товаров, PDF документов) — храним прямо в БД как bytea, не во
// внешнем сторедже: на масштабе этого проекта (десятки файлов, мегабайты, не
// гигабайты) это проще, чем поднимать S3-совместимое хранилище ради пары
// ключей доступа. Отдаётся через app/api/assets/[id]/route.ts, Product.imageUrl
// и Document.fileUrl хранят ссылку на этот роут (`/api/assets/<id>`).
model Asset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@map("assets")
}
